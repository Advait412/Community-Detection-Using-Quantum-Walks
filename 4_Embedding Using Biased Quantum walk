import math
import numpy as np
import networkx as nx 
import matplotlib.pyplot as plt

w_a = 25
w_b = 1
time_steps = 10
dimension = 100
adj_matrix = np.load("barabasi_adj_matrix_"+str(dimension)+"nodes.npy")
adj_networkx = nx.from_numpy_array(adj_matrix)


deg_list = np.zeros(dimension)
for i in range(dimension):
    deg_list[i] = np.sum(adj_matrix[i])

dist_matrix = np.zeros((dimension,dimension))
for i in range(dimension):
    for j in range(dimension):
        dist_matrix[i][j] = nx.shortest_path_length(adj_networkx, source=i, target=j)
           
print("digstra done")      
    
# Shift operator is independent of source

shift_operator = np.zeros((int(np.sum(adj_matrix)),int(np.sum(adj_matrix))))
link_count_list = np.zeros(dimension) # used in shift operator and initial state

for i in range(len(adj_matrix)):
    j = 0
    while j<=i:
        if adj_matrix[i][j] != 0:   # only unweighted, undirected graphs
            pos_i = int(np.sum(deg_list[:i]) + link_count_list[i]) 
            pos_j = int(np.sum(deg_list[:j]) + link_count_list[j])     
            shift_operator[pos_i][pos_j] = 1
            shift_operator[pos_j][pos_i] = 1
            link_count_list[i] +=1
            link_count_list[j] +=1
        j+=1   
          
def generate_coin_for_node(n):
        neighbours = []
        for i in range(len(adj_matrix)):
            if adj_matrix[n][i] != 0:
                neighbours.append(i)
        node_coin_size = len(neighbours)
        
        bra_s = np.zeros(node_coin_size)
        for i in range(node_coin_size):
            if dist_matrix[source][n] > dist_matrix[source][i]:
                bra_s[i] = math.sqrt(w_a)
            elif dist_matrix[source][n] <= dist_matrix[source][i]:
                bra_s[i] = math.sqrt(w_b)
        bra_s = bra_s.reshape(1,-1)
        bra_s = bra_s/np.linalg.norm(bra_s)
                                                # check if bra and ket are correct
        ket_s = bra_s.conj().T                   # if functions are working properly
        node_coin = 2*(ket_s @ bra_s) - np.eye(node_coin_size)
        return(node_coin)

final_rep_matrix = np.zeros((time_steps,dimension))  

for itr in range(dimension):
    print(itr)
    source = itr          
    size_coin_operator = int(np.sum(adj_matrix))# for unweighted networks
    coin_operator = np.zeros((size_coin_operator,size_coin_operator)) 

    mark = 0
    for i in range(dimension):
        node_coin = generate_coin_for_node(i)
        for j in range(len(node_coin)):
            for k in range(len(node_coin)):
                coin_operator[j+mark][k+mark] = node_coin[j][k]
        mark += len(node_coin) 

    index_map = {}  # for setting initial state (idex are mapped to respective node)
    counter = 0
    for i in range(dimension):
        j = 0
        while j < deg_list[i]:
            index_map.update({counter:i})
            counter+=1
            j+=1
           
    state_initial = np.zeros(len(shift_operator))  
    for i in range(len(shift_operator)):
        for j in range(len(shift_operator)):
            if shift_operator[i][j] !=0:
                connection = j   # as one index is mapped symmetrically 
                break            # and uniquely to just one another one

        if dist_matrix[source][index_map[i]] > dist_matrix[source][index_map[connection]] :
            state_initial[i] = np.sqrt(w_a)
        elif dist_matrix[source][index_map[i]] <= dist_matrix[source][index_map[connection]] :
            state_initial[i] = np.sqrt(w_b)
            
    # Normalising initial state the way in the paper
    for node in range(dimension):
        start = int(np.sum(link_count_list[:node])) 
        stop = int(np.sum(link_count_list[:node+1]))
        N_factor = 0
        for node_link in range(start,stop):
            if node_link == start:
                for _ in range(start,stop):
                    N_factor += state_initial[_]*state_initial[_].conjugate()
                N_factor = np.sqrt(N_factor)
            state_initial[node_link] /= N_factor
    state_initial /= np.sqrt(dimension)
        
         
    trans_operator = np.dot(shift_operator,coin_operator)
    
    rep_matrix = []
    for t in range(time_steps):
        state_final = (np.dot(np.linalg.matrix_power(trans_operator,t),state_initial)) 
        probability = np.zeros(dimension)
        counter = 0
        for i in range(dimension):
            prob = 0
            node_states = int(deg_list[i])
            for j in range(node_states):
                prob += abs(state_final[counter]**2) 
                counter+=1
            probability[i] = prob
        rep_matrix.append(probability)
    rep_matrix = np.array(rep_matrix)
    final_rep_matrix +=rep_matrix

final_rep_matrix = final_rep_matrix.T
for i in  range(len(final_rep_matrix)):
    final_rep_matrix[i] = final_rep_matrix[i]/np.linalg.norm(final_rep_matrix[i])
    
np.save("Q_walk_vectors",final_rep_matrix)

with open ("Q_walk_vectors.txt" , 'w' ) as f :
    for row in final_rep_matrix :
        f.write(','.join(map(str, row)) + '\n') 
